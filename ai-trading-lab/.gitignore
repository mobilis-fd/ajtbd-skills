# environments
.venv/
__pycache__/
*.pyc
.pytest_cache/
# data (raw/processed market data is never committed)
/data/
user_data/data/
user_data/backtest_results/
user_data/logs/
user_data/hyperopt_results/
user_data/plot/
*.sqlite
*.sqlite-*
*.db
# large run artefacts (csv/json/md summaries ARE committed)
reports/runs/**/*.parquet
# secrets: never commit credentials; live keys are not used in this project
.env
.env.*
*secret*
*private*.json
config_live*.json
approvals/
# v0.2 large run artefacts (csv/json/md summaries are committed)
reports/v02/runs/**/*.parquet
reports/v02/runs_superseded/**/*.parquet
# large v0.2 CSVs are committed as deterministic gzip (gzip -n); gunzip reproduces the manifest sha256
reports/v02/runs/**/trades.csv
reports/v02/runs/**/g01_predictions_H60.csv
reports/v02/runs/**/equity_hourly_primary.csv
reports/v02/runs_superseded/**/trades.csv
reports/v02/runs_superseded/**/g01_predictions_H60.csv
reports/v02/runs_superseded/**/equity_hourly_primary.csv
dist/
