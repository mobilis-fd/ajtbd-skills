{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "ai-trading-lab-mvp-backtest",
  "dry_run": true,
  "dry_run_wallet": 100,
  "trading_mode": "spot",
  "margin_mode": "",
  "stake_currency": "USDT",
  "stake_amount": 50,
  "tradable_balance_ratio": 1.0,
  "max_open_trades": 1,
  "timeframe": "5m",
  "fiat_display_currency": "",
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {"entry": 10, "exit": 10, "unit": "minutes"},
  "entry_pricing": {"price_side": "other", "use_order_book": false, "order_book_top": 1, "price_last_balance": 0.0,
                    "check_depth_of_market": {"enabled": false, "bids_to_ask_delta": 1}},
  "exit_pricing": {"price_side": "other", "use_order_book": false, "order_book_top": 1},
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": ["BTC/USDT", "ETH/USDT", "SOL/USDT"],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "dataformat_ohlcv": "feather",
  "datadir": "user_data/data/binance",
  "user_data_dir": "user_data",
  "strategy_path": "user_data/strategies",
  "internals": {"process_throttle_secs": 5}
}
